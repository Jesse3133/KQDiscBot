# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_TOKEN=

# Time zone the game schedules events in. Fiesta NA follows US Pacific time,
# including daylight saving. Change only if the event times stop matching.
GAME_TIMEZONE=America/Los_Angeles

# Your server's ID: the bot only works there, and leaves any other server it's
# added to. Separate several with commas. Get it by right-clicking the server
# icon -> Copy Server ID (needs Developer Mode, see docs/discord-setup.md).
# If left empty the bot works in every server, which isn't safe.
ALLOWED_GUILD_IDS=

# Optional: your test server's ID. When set, slash commands are registered
# there instantly instead of globally (handy while developing).
DEV_GUILD_ID=

# Optional: where the bot keeps its data (roles, channels, events).
# Defaults to kqbot.sqlite3 in the folder you start the bot from.
DATABASE_PATH=
